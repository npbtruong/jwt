APP_NAME="Webhook Receiver"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8 service "mysql" in docker-compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webhook
DB_USERNAME=webhook
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Queue over Redis (the notifications queue is worked by a separate container) ---
QUEUE_CONNECTION=redis

# --- Cache over Redis ---
CACHE_STORE=redis
CACHE_PREFIX=

# --- Redis (service "redis" in docker-compose) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail: 'log' writes the email into storage/logs (visible in worker output) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@webhook-receiver.test"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
#  Microservice-specific config
# ============================================================

# --- JWT (HS256). Generate a dedicated secret, e.g.:
#     docker compose exec app php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=3600
JWT_ISSUER="${APP_URL}"
JWT_LEEWAY=5

# --- Idempotency (Redis SET NX EX) ---
IDEMPOTENCY_PREFIX=idem:webhook:
IDEMPOTENCY_TTL=86400

# --- Notification queue job retry policy ---
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_TRIES=3
NOTIFICATIONS_BACKOFF=10,30,60
NOTIFICATIONS_TIMEOUT=30

# --- Rate limits ("maxAttempts,perMinutes") ---
RATELIMIT_TOKEN=10,1
RATELIMIT_WEBHOOK=60,1
